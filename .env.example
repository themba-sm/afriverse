# AFRIVERSE website environment variables
# Copy to .env for local development. Vite only exposes variables
# prefixed with VITE_ to client-side code. Never commit real secrets:
# .env is git-ignored; only this .example file is tracked.

# Consultation form submission endpoint (Base44 backend function URL).
# Optional — falls back to the production endpoint in src/data/site.js.
VITE_ENQUIRY_ENDPOINT=
